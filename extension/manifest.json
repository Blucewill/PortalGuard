{
  "manifest_version": 3,
  "name": "PortalGuard Shield",
  "version": "0.1.0",
  "description": "Warns you before you sign a wallet permission a drainer could abuse. Checks the PortalGuard Drainer Registry on Portaldot.",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_popup": "popup.html", "default_title": "PortalGuard Shield" },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage"],
  "host_permissions": ["https://test-evm-rpc-v3.portaldot.dev/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["detect.js", "inject.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
